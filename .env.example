# ── Database ────────────────────────────────────────────────────────────────
# Option A (Docker):   `docker compose up -d` → postgresql://purrple:prose@localhost:5432/purrple_prose
# Option B (Homebrew): `brew install postgresql@17 pgvector && brew services start postgresql@17`
#                      then `createdb purrple_prose` → postgresql://<your-username>@localhost:5432/purrple_prose
DATABASE_URL="postgresql://purrple:prose@localhost:5432/purrple_prose"

# ── Auth (Phase 1) ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Google OAuth — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── AI (Phase 4+) ───────────────────────────────────────────────────────────
# The agent layer picks a provider automatically:
#   CLAUDE_CODE_OAUTH_TOKEN set → Claude Agent SDK (local dev via your
#     Claude subscription; generate with: claude setup-token)
#   ANTHROPIC_API_KEY set       → also works with the SDK; used for deploys
#   neither                     → deterministic mock (app stays demoable)
# Force with LLM_PROVIDER="sdk" | "mock".
CLAUDE_CODE_OAUTH_TOKEN=""
ANTHROPIC_API_KEY=""
LLM_PROVIDER=""
# Models (defaults shown)
AGENT_MODEL="claude-sonnet-5"
AGENT_MODEL_FAST="claude-haiku-4-5-20251001"

# ── Embeddings (Phase 5) ────────────────────────────────────────────────────
# Provider for the RAG "lore bible". Options: stub | voyage | openai
# `stub` is deterministic and needs no key — fine for local dev/demo.
EMBEDDINGS_PROVIDER="stub"
VOYAGE_API_KEY=""

# ── Deploy (Vercel) ─────────────────────────────────────────────────────────
# Protects /api/cron/coach; set to any random string in Vercel env vars.
CRON_SECRET=""
