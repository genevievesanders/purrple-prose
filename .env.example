# ── Database ────────────────────────────────────────────────────────────────
# Option A (Docker):   `docker compose up -d` → postgresql://purrple:prose@localhost:5432/purrple_prose
# Option B (Homebrew): `brew install postgresql@17 pgvector && brew services start postgresql@17`
#                      then `createdb purrple_prose` → postgresql://<your-username>@localhost:5432/purrple_prose
DATABASE_URL="postgresql://purrple:prose@localhost:5432/purrple_prose"

# ── Auth (Phase 1) ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Google OAuth — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── AI (Phase 4+) ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ── Embeddings (Phase 5) ────────────────────────────────────────────────────
# Provider for the RAG "lore bible". Options: stub | voyage | openai
# `stub` is deterministic and needs no key — fine for local dev/demo.
EMBEDDINGS_PROVIDER="stub"
VOYAGE_API_KEY=""
