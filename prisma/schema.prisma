// Purrple Prose — Prisma schema
// pgvector is enabled via the postgresqlExtensions preview feature.
// Vector columns (Phase 5) will use Unsupported("vector") + raw SQL for ANN queries.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())

  entries       Entry[]
  dailyWords    DailyWordCount[]
  milwordyGoals MilwordyGoal[]
  coachNotes    CoachNote[]
}

// A note the coach cat leaves when the writer is behind pace — at most one
// per user per day; unread until the writer opens it.
model CoachNote {
  id        String    @id @default(cuid())
  userId    String
  date      DateTime  @db.Date
  text      String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// Milwordy: opt-in million-words-a-year challenge. One active goal per
// user; the challenge runs one year from startDate.
model MilwordyGoal {
  userId      String   @id
  targetWords Int      @default(1000000)
  startDate   DateTime @default(now()) @db.Date
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Entry {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("Untitled")
  // URL slug derived from the title on save; null until first titled save
  // (routes fall back to the id). Unique per user, collision-suffixed.
  slug      String?
  content   String   @default("")
  tags      String[] @default([])
  wordCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks EntryChunk[]

  @@unique([userId, slug])
  @@index([userId, updatedAt(sort: Desc)])
}

// The "lore bible": embedded chunks of every entry, per-user isolated.
// Vector ops go through raw SQL (src/lib/agents/memory/store.ts); every
// query there is scoped by userId.
model EntryChunk {
  id        String                 @id @default(cuid())
  userId    String
  entryId   String
  seq       Int
  text      String
  embedding Unsupported("vector(384)")

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entryId])
}

// Words written per user per calendar day (user's local day, computed
// client/server-side as a YYYY-MM-DD string @db.Date).
// Only positive deltas accumulate: deleting 100 words then writing 100 new
// ones counts as 100 written — "words written", not "net growth".
model DailyWordCount {
  userId String
  date   DateTime @db.Date
  words  Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
}
